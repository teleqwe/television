{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Television",
  "version": "0.2.0",
  "identifier": "com.teleqwe.television",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": ["icons/icon.png"],
    "linux": {
      "deb": { "depends": ["libpipewire-0.3-0", "ffmpeg", "xdg-desktop-portal", "libegl1", "libopengl0"] },
      "rpm": { "depends": ["pipewire-libs", "ffmpeg-libs", "xdg-desktop-portal", "libglvnd-egl", "libglvnd-opengl"] }
    }
  }
}
